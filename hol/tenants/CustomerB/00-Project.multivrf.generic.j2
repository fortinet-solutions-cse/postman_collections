{#                            Project Template                                #}
{# -------------------------------------------------------------------------- #}
{# This file describes the project: its Regions, Hubs and Device Profiles     #}
{# Normally, this is the only file that needs to be edited between            #}
{# different projects                                                         #}
{# -------------------------------------------------------------------------- #}
{# Design flavor: "Dynamic BGP on Loopback"                                   #}
{# Please contact your Fortinet representatives for more details              #}

{#
  Per-device variables used:
  - Required:
    - hostname
    - loopback
    - profile
    - region
    - h1_isp1
    - h1_isp2
    - h2_isp1
    - h2_isp2
  - Depending on topology:
    - isp1_intf
    - isp2_intf
    - lte_intf
    - lan_fin_intf
    - lan_fin_ip
    - lan_edu_intf
    - lan_edu_ip
#}

{# Optional settings #}
{% set cert_auth = false %}
{% set dhcp_server_startip = 101 %}
{% set regex_as = "6500." %}

{# Optional defaults (can be overriden by profiles) #}
{% set advpn2 = true %}
{% set dynamic_bgp = true %}

{#  Mandatory Global Definitions #}
{% set lo_summary = '10.200.0.0/14' %}

{# Regions #}
{% set regions = {
    'SuperWAN': {
      'as': '65001',
      'vrfs': [
        {
          'id': 11,
          'lan_summary': '10.0.0.0/14'          
        },
        {
          'id': 12,
          'lan_summary': '10.0.0.0/14'          
        }
      ],
      'hubs': [ 'site1-H1', 'site1-H2' ]
    }
  }
%}

{# Device Profiles #}
{% set profiles = {

    'JustBranch': {
      'interfaces': [
        {
          'name': isp1_intf,
          'role': 'wan',
          'ol_type': 'ISP1',
          'ip': 'dhcp'
        },
        {
          'name': isp2_intf,
          'role': 'wan',
          'ol_type': 'ISP2',
          'ip': 'dhcp'
        },
        {
          'name': lte_intf,
          'role': 'wan',
          'ul_name': 'LTE',
          'ol_type': 'ISP2',
          'backup': true,
          'ip': 'dhcp'
        },
        {
          'name': lan_intf_edu,
          'role': 'lan',
          'vrf': 11,
          'ip': lan_ip_edu,
          'allow_dia': true
        },
        {
          'name': lan_intf_fin,
          'role': 'lan',
          'vrf': 12,
          'ip': lan_ip_fin
        }
      ]
    },

    'DC': {
      'interfaces': [
        {
          'name': isp1_intf,
          'role': 'wan',
          'ol_type': 'ISP1',
          'ip': 'dhcp'
        },
        {
          'name': isp2_intf,
          'role': 'wan',
          'ol_type': 'ISP2',
          'ip': 'dhcp'
        },
        {
          'name': lan_intf_edu,
          'role': 'lan',
          'vrf': 11,
          'ip': lan_ip_edu
        },
        {
          'name': lan_intf_fin,
          'role': 'lan',
          'vrf': 12,
          'ip': lan_ip_fin
        }
      ]
    }   

  }
%}

