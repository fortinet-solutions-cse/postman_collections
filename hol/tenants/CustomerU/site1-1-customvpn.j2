config vpn ipsec phase2-interface
    edit "CORP_VPN"
        set phase1name "CORP_VPN"
        set proposal aes128-sha256 aes256-sha256
        set dhgrp 5 15
    next


    edit "RC-VPN"
        set phase1name "RC-VPN"
        set proposal aes128-sha1 aes256-sha1 aes128-sha256 aes256-sha256 aes128gcm aes256gcm chacha20poly1305
        set dhgrp 5 15
    next

end

config system interface
    edit "CORP_VPN"
        set vdom "root"
        set ip 10.10.10.254 255.255.255.255
        set type tunnel
        set snmp-index 2
        set interface "port1"
    next
end

config user group
    edit "FAC"
        set member "CORP_SAML_SERVER"
    next
    edit "SASE-SSO-GRP"
        set member "SASE_VPN_SSO"
    next
end

config firewall policy
    edit 0
        set name "Corporate-VPN-SIA"
        set srcintf "CORP_VPN"
        set dstintf "underlay"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set utm-status enable
        set inspection-mode proxy
        set ssl-ssh-profile "custom-deep-inspection"
        set av-profile "outbound"
        set webfilter-profile "outbound"
        set dlp-profile "outbound"
        set ips-sensor "outbound"
        set application-list "outbound"
        set logtraffic all
        set nat enable
        set groups "FAC"
    next
    edit 0
        set name "Corporate-VPN-SPA"
        set srcintf "CORP_VPN"
        set dstintf "overlay" "lan_zone"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
        set utm-status enable
        set inspection-mode proxy
        set ssl-ssh-profile "custom-deep-inspection"
        set av-profile "outbound"
        set dlp-profile "outbound"
        set ips-sensor "outbound"
        set application-list "outbound"
        set logtraffic all
        set groups "FAC"
    next
end

config system dns-server
    edit "CORP_VPN"
    next
end

config system dns-database
    edit "unisase"
        set domain "unisase.lab"
        set authoritative disable
        set forwarder "10.1.0.7"
        set source-ip 10.10.10.254
    next
end

config router route-map
    edit "CorporateVPN"
        config rule
            edit 1
                set match-interface "CORP_VPN"
                unset set-ip-prefsrc
            next
            edit 2
                set match-interface "RC-VPN"
                unset set-ip-prefsrc
            next
        end
    next
end

config router bgp
    config redistribute "connected"
        set status enable
        set route-map "CorporateVPN"
    end
    config redistribute "static"
        set status enable
        set route-map "CorporateVPN"
    end
end