config system interface
    edit "port1"
        set vdom "root"
        set mode dhcp
        set allowaccess ping probe-response fabric
        set type physical
        set ike-saml-server "CORP_SAML_SERVER"
        set lldp-reception enable
        set role wan
        set snmp-index 1
    next


    edit "port2"
        set vdom "root"
        set mode dhcp
        set allowaccess ping probe-response fabric
        set type physical
        set ike-saml-server "SASE_VPN_SSO"
        set lldp-reception enable
        set role wan
        set snmp-index 107
    next

 end

