config vpn ssl settings
    set banned-cipher SHA1 SHA256 SHA384
    set servercert ''
    set port 11443
end

config system global
    set admin-scp enable
    set admin-sport 8443
    set admintimeout 480
    set alias "FortiGate-VM64-KVM"
    set auth-ike-saml-port 443
    set hostname "site1-1"
    set timezone "US/Pacific"
end


config user setting
    set auth-cert "FortiDemo_Wildcard_092025"
end

config user saml
    edit "CORP_SAML_SERVER"
        set entity-id "http://ipsec.fortidemo.fortinet.com/remote/saml/metadata/"
        set single-sign-on-url "https://ipsec.fortidemo.fortinet.com/remote/saml/login"
        set single-logout-url "https://ipsec.fortidemo.fortinet.com/remote/saml/logout"
        set idp-entity-id "http://fac.fortidemo.fortinet.com:21443/saml-idp/corp/metadata/"
        set idp-single-sign-on-url "https://fac.fortidemo.fortinet.com:21443/saml-idp/corp/login/"
        set idp-single-logout-url "https://fac.fortidemo.fortinet.com:21443/saml-idp/corp/logout/"
        set idp-cert "REMOTE_Cert_1"
        set user-name "username"
        set group-name "group"
        set digest-method sha1
    next
    edit "SASE_VPN_SSO"
        set entity-id "https://turbo-3mrt467w.edge.demo.fortisase.com/remote/saml/metadata"
        set single-sign-on-url "https://turbo-3mrt467w.edge.demo.fortisase.com/remote/saml/login"
        set single-logout-url "https://turbo-3mrt467w.edge.demo.fortisase.com/remote/saml/logout"
        set idp-entity-id "http://fac.fortidemo.fortinet.com:21443/saml-idp/sase/metadata/"
        set idp-single-sign-on-url "https://fac.fortidemo.fortinet.com:21443/saml-idp/sase/login/"
        set idp-single-logout-url "https://fac.fortidemo.fortinet.com:21443/saml-idp/sase/logout/"
        set idp-cert "REMOTE_Cert_1"
        set user-name "username"
        set group-name "group"
        set digest-method sha1
    next
end


config system interface
    edit "port1"
        set vdom "root"
        set mode dhcp
        set allowaccess ping probe-response fabric
        set type physical
        set ike-saml-server "CORP_SAML_SERVER"
        set lldp-reception enable
        set role wan
        set snmp-index 1
    next


    edit "port2"
        set vdom "root"
        set mode dhcp
        set allowaccess ping probe-response fabric
        set type physical
        set ike-saml-server "SASE_VPN_SSO"
        set lldp-reception enable
        set role wan
        set snmp-index 107
    next

 end

